# BirdVision webapp config — copy to config.yaml and edit.
#
# Secrets (google_client_id, google_client_secret, session_secret) are
# overridden by GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / SESSION_SECRET
# env vars. Prefer the env-var path — see README "Secrets" section for
# the recommended `op run` pattern that resolves them from 1Password.

detector:
  model: /data/models/yolov8s.pt
  confidence: 0.4
  device: cuda
  enable_small_bird_zoom_fallback: true
  small_bird_fallback_every_n_frames: 5

classifier:
  model: hf-hub:imageomics/bioclip
  device: cuda
  top_k: 20
  classify_every_n_frames: 10
  crop_padding_ratio: 0.18
  crop_padding_ratio_min: 0.04
  crop_closeup_area_ratio: 0.06
  min_crop_area: 2500
  min_event_confidence: 0.35
  ensemble:
    enabled: true
    secondary_model: chriamue/bird-species-classifier
    alpha: 0.6   # BioCLIP weight
    beta: 0.4    # secondary classifier weight

tracker:
  max_disappeared: 120
  iou_threshold: 0.2
  min_frames_to_report: 8
  centroid_max_distance: 0.18
  min_confidence_to_report: 0.6

metadata:
  # Fallback coords when an uploaded clip has no GPS. Use a real value for
  # your deployment. The example below is somewhere on Long Island, NY.
  latitude: 40.7
  longitude: -73.5
  ebird_db: /app/data/ebird_priors.db
  local_priors_file: /app/data/local_priors.yaml
  ebird_fips: US-NY-059
  prior_mode: seasonal  # seasonal | location_only

scoring:
  center_weight_strength: 2.0

species:
  list_file: data/species_lists/north_america_common.txt
  prompt_template: a photo of a {species}

output:
  results_dir: /data/results

webapp:
  upload_dir: /data/videos
  debug: false
  # Transcode VP9/AV1 videos to H.264 before ML processing so they play
  # natively in Safari/iOS. Set to false to disable.
  transcode_incompatible_video: true
  # Path to a YAML file listing API tokens permitted to POST /api/v1/videos.
  # If unset (or the file is missing/empty), the API endpoint returns 503;
  # the browser /upload route is unaffected.
  api_tokens_file: /data/api_tokens.yaml

auth:
  # Prefer env-var overrides: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  # SESSION_SECRET. Values here are fallbacks only.
  google_client_id: ""
  google_client_secret: ""
  redirect_uri: "https://your-host.example.com/auth/callback"
  session_secret: ""
  # Emails permitted to upload through the browser /upload route.
  # OAuth is disabled if google_client_id, google_client_secret, or
  # session_secret are empty.
  allowed_emails: []
