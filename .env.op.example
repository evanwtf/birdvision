# BirdVision deployment env template, resolved by `op run`.
# Copy to .env.op (or pass directly to op run --env-file).
#
# Usage:
#   op run --env-file .env.op.example -- docker compose up
#
# On a headless host, set OP_SERVICE_ACCOUNT_TOKEN in the real environment
# (not in this file) so `op` runs non-interactively. The service account
# must have read access to the `BirdVision` vault.

GOOGLE_CLIENT_ID=op://BirdVision/google-oauth/client id
GOOGLE_CLIENT_SECRET=op://BirdVision/google-oauth/password
SESSION_SECRET=op://BirdVision/session-secret/password
