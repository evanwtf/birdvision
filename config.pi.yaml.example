# BirdVision Pi — Backyard mode (USB capture card, e.g. Elgato Cam Link 4K).
# For phone sidecar mode, use config.pi.sidecar.yaml.example instead.
# Copy to config.pi.yaml and edit.

stream:
  source: v4l2
  device: /dev/video0
  format: yuyv422
  width: 1920
  height: 1080
  framerate: 59.94

# HailoRT 4.23.0 — matches hailort_4.23.0_arm64.deb installed on host
detector:
  hef: /app/pi/models/yolov8n.hef
  confidence: 0.4
  device: /dev/hailo0
  enable_small_bird_zoom_fallback: true
  small_bird_fallback_every_n_frames: 5
  fallback_crop_ratio: 0.5

classifier:
  hef: /app/pi/models/efficientnet_s_birds.hef
  labels: /app/pi/models/species_labels.json
  top_k: 20
  classify_every_n_frames: 10
  crop_padding_ratio: 0.18
  crop_padding_ratio_min: 0.04
  crop_closeup_area_ratio: 0.06
  min_crop_area: 2500
  min_event_confidence: 0.35

tracker:
  max_disappeared: 120
  iou_threshold: 0.2
  min_frames_to_report: 8
  centroid_max_distance: 0.18
  min_confidence_to_report: 0.6

scoring:
  center_weight_strength: 2.0

metadata:
  # Coords for the camera location — used for eBird prior lookup.
  latitude: 40.7
  longitude: -73.5
  ebird_db: /app/data/ebird_priors.db
  ebird_fips: US-NY-059
  prior_mode: seasonal
  local_priors_file: /app/data/local_priors.yaml

output:
  results_dir: /data/results
  log_interval_seconds: 1
  stats_interval_seconds: 30

# Pi Touch Display 2 overlay — live feed + CC-style species caption on /dev/fb0.
# Set enabled: false for headless/SSH deployments without a framebuffer.
display:
  enabled: true
  device: /dev/fb0
  rotate: 90              # 0/90/180/270 — physical display is landscape via 90° CW
  show_fps: false
  show_boxes: true
  caption_ttl_seconds: 3  # how long a species label stays on screen after last event
