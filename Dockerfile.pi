# BirdVision — Raspberry Pi 5 / Hailo-8 runtime image
# Architecture: linux/arm64
# Build on Pi or cross-compile with: docker buildx build --platform linux/arm64

# ── builder ───────────────────────────────────────────────────────────────────
FROM ubuntu:24.04 AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Build deps only
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml uv.lock ./
# Install only Pi dependency group; skip x86-only packages
RUN uv sync --frozen --no-install-project --group pi

# ── runtime ───────────────────────────────────────────────────────────────────
FROM ubuntu:24.04 AS runtime

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Runtime system deps
# TODO (#72): install HailoRT runtime .deb from Hailo developer zone
# e.g.: COPY hailort_4.20.0_arm64.deb /tmp/
#        RUN apt-get install -y /tmp/hailort_4.20.0_arm64.deb
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    ffmpeg \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv

COPY src/ ./src/
COPY scripts/ ./scripts/
COPY data/ ./data/

# Pi models directory — bind-mount or copy HEF files here at runtime
RUN mkdir -p /app/pi/models

RUN useradd -m -u 1000 nonroot && chown -R nonroot:nonroot /app
RUN mkdir -p /data/results && chown nonroot:nonroot /data/results

VOLUME ["/data/results"]

USER nonroot

ENV PYTHONUNBUFFERED=1

CMD ["/usr/local/bin/uv", "run", "scripts/realtime_identify.py", "--config", "/app/config.pi.yaml"]
